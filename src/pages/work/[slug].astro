---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MountainHero from '../../components/MountainHero.astro';
import CodePanel from '../../components/CodePanel.astro';
import CtaBand from '../../components/CtaBand.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={`${d.title} | Jon Zaro`} description={d.summary}>
  <MountainHero size="compact">
    <a href="/#work" class="crumb">← All case studies</a>
    <div class="hero-meta">
      <span class="tnum">{d.period}</span>
      <span aria-hidden="true">·</span>
      <span>{d.client}</span>
      {d.status === 'in-progress' && <span class="hero-tag">In progress</span>}
    </div>
    <h1 class="display-xl case-title">{d.title}</h1>
  </MountainHero>

  <section class="intro">
    <div class="container intro-grid">
      <div>
        <p class="summary">{d.summary}</p>
        <dl class="facts">
          <div>
            <dt class="caption">Role</dt>
            <dd>{d.role}</dd>
          </div>
          <div>
            <dt class="caption">Timeline</dt>
            <dd class="tnum">{d.period}</dd>
          </div>
          <div class="facts-stack">
            <dt class="caption">Stack</dt>
            <dd class="tag-row">{d.stack.map((s) => <span class="tag">{s}</span>)}</dd>
          </div>
        </dl>
      </div>
      <div class="panel-wrap">
        <CodePanel file={d.panel.file} lines={d.panel.lines} />
      </div>
    </div>
  </section>

  {
    d.stats.length > 0 && (
      <section class="stats" aria-label="Results">
        <div class="container">
          <ul class="stats-grid">
            {d.stats.map((s) => (
              <li>
                <span class="stat-value tnum">{s.value}</span>
                <span class="caption">{s.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <article class="section">
    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <section class="next-wrap">
    <div class="container">
      <a href={`/work/${next.id}/`} class="next">
        <span class="caption">Next case study</span>
        <span class="heading-lg">{next.data.title} <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .crumb {
    display: inline-block;
    color: rgba(255, 255, 255, 0.88);
    font-size: 14px;
    font-weight: 400;
    margin-bottom: 20px;
  }
  .crumb:hover {
    color: var(--on-primary);
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 14px;
  }
  .hero-tag {
    padding: 3px 9px;
    border-radius: var(--r-pill);
    background: rgba(255, 196, 107, 0.25);
    border: 1px solid rgba(255, 196, 107, 0.55);
    font-size: 12px;
  }
  .case-title {
    max-width: 880px;
    color: var(--on-primary);
    text-shadow: 0 1px 24px rgba(8, 40, 70, 0.25);
  }

  .intro {
    padding: 56px 0 0;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .intro-grid > * {
    min-width: 0;
  }
  .summary {
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink-secondary);
    letter-spacing: -0.2px;
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 24px;
    margin: 32px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--hairline);
  }
  .facts dd {
    margin: 4px 0 0;
    font-weight: 400;
  }
  .facts-stack {
    grid-column: 1 / -1;
  }
  .facts-stack dd {
    margin-top: 8px;
  }
  .panel-wrap {
    margin-top: -150px;
    position: relative;
    z-index: 2;
  }

  .stats {
    padding: 56px 0 0;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stats-grid li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    border-radius: var(--r-lg);
    background: var(--canvas-soft);
    border: 1px solid var(--hairline);
  }
  .stat-value {
    font-size: 34px;
    letter-spacing: -0.9px;
    color: var(--brand-dark-900);
  }

  .prose {
    max-width: 720px;
    font-size: 17px;
    line-height: 1.7;
    font-weight: 350;
    color: var(--ink-secondary);
  }
  .prose :global(h2) {
    margin: 48px 0 14px;
    font-size: 26px;
    letter-spacing: -0.4px;
    line-height: 1.2;
    color: var(--ink);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p) {
    margin: 0 0 18px;
  }
  .prose :global(strong) {
    font-weight: 550;
    color: var(--ink);
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.86em;
    padding: 2px 6px;
    border-radius: var(--r-xs);
    background: var(--canvas-soft);
    border: 1px solid var(--hairline);
    color: var(--ink);
  }

  .next-wrap {
    padding-bottom: 16px;
  }
  .next {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    color: var(--ink);
  }
  .next:hover {
    color: var(--primary);
  }

  @media (max-width: 1023px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .panel-wrap {
      margin-top: 0;
    }
  }
  @media (max-width: 767px) {
    .summary {
      font-size: 18px;
    }
    .stats-grid {
      grid-template-columns: 1fr;
    }
    .prose {
      font-size: 16px;
    }
  }
</style>
