---
import Base from '../layouts/Base.astro';
import MountainHero from '../components/MountainHero.astro';
---

<Base title="Page not found | Jon Zaro">
  <MountainHero size="compact">
    <h1 class="display-xl" style="color: var(--on-primary)">This trail doesn’t go anywhere.</h1>
    <p style="margin-top: 16px; font-size: 18px; color: rgba(255,255,255,0.9)">
      <a href="/" style="color: #fff; text-decoration: underline">Head back to the homepage →</a>
    </p>
  </MountainHero>
</Base>
