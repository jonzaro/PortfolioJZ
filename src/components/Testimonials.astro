---
// Verbatim, from Michael directly. Also shown on the subscription-data-repair case study.
const featured = {
  text: 'Jon’s ability to see the big picture led him to identify and architect and solve a real subscription reporting error. Having trust in our data being accurate helps us steer the boat.',
  name: 'Michael Z.',
  relation: 'Strategy and client relations, Burn',
};

// Verbatim excerpts from LinkedIn recommendations; "…" marks a cut. Don't reword them.
const quotes = [
  {
    text: 'He picks up complex systems and tools incredibly quickly — and doesn’t just learn them, he masters them and starts making an impact right away. … Our team runs more efficiently and has more time to focus on revenue growth because of his contributions.',
    name: 'Victoria Lynn C.',
    relation: 'Worked with Jon on another team at Smash Creative',
    date: 'May 2025',
  },
  {
    text: 'He consistently took projects from concept to deployment, seamlessly handling both frontend and backend tasks. His expertise in AI tooling, particularly integrating custom GPT models into apps, made a huge impact on project efficiency and functionality.',
    name: 'Steve R.',
    relation: 'Managed Jon directly at Smash Creative',
    date: 'Mar 2025',
  },
  {
    text: 'Jon is a strong engineer with a unique ability to think outside the box. While working with Jon, he was crucial in business automations utilizing various tools including AI. These automations led to saved time and efficiency as a company.',
    name: 'Kevin M.',
    relation: 'Managed Jon directly at Smash Creative',
    date: 'Oct 2024',
  },
];
---

<section class="quotes" aria-labelledby="quotes-title">
  <div class="container">
    <p class="quotes-title caption" id="quotes-title">From the people I’ve worked with</p>
    <figure class="quote quote--featured">
      <blockquote>
        <p>“{featured.text}”</p>
      </blockquote>
      <figcaption>
        <span class="quote-name">{featured.name}</span>
        <span class="quote-meta">{featured.relation}</span>
      </figcaption>
    </figure>
    <ul class="quotes-grid">
      {
        quotes.map((q) => (
          <li>
            <figure class="quote">
              <blockquote>
                <p>“{q.text}”</p>
              </blockquote>
              <figcaption>
                <span class="quote-name">{q.name}</span>
                <span class="quote-meta">
                  {q.relation} · <span class="tnum">{q.date}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .quotes {
    padding: 40px 0 8px;
  }
  .quotes-title {
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 12px;
  }
  .quotes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .quote {
    display: flex;
    flex-direction: column;
    gap: 18px;
    height: 100%;
    margin: 0;
    padding: 24px 24px 22px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    background: var(--canvas-soft);
  }
  .quote blockquote {
    flex: 1;
    margin: 0;
  }
  .quote blockquote p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-secondary);
  }
  .quote figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 14px;
    border-top: 1px solid var(--hairline);
  }
  .quote--featured {
    height: auto;
    margin-bottom: 20px;
    padding: 32px 36px 28px;
    background: var(--canvas-cream);
    border-color: transparent;
  }
  .quote--featured blockquote p {
    max-width: 880px;
    font-size: 22px;
    line-height: 1.4;
    letter-spacing: -0.22px;
    font-weight: 300;
    color: var(--ink);
  }
  .quote--featured figcaption {
    border-top-color: rgba(155, 104, 41, 0.25);
  }
  .quote-name {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }
  .quote-meta {
    font-size: 13px;
    color: var(--ink-mute);
  }
  @media (max-width: 1023px) {
    .quotes-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
  @media (max-width: 767px) {
    .quote--featured {
      margin-bottom: 12px;
      padding: 24px 22px 22px;
    }
    .quote--featured blockquote p {
      font-size: 19px;
    }
  }
</style>
