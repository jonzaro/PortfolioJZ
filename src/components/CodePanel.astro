---
interface Line {
  kind: 'code' | 'comment' | 'add' | 'del' | 'ok' | 'warn' | 'dim';
  text: string;
}
interface Props {
  file: string;
  lines: Line[];
  compact?: boolean;
}
const { file, lines, compact = false } = Astro.props;
---

<figure class:list={['panel', { compact }]}>
  <figcaption class="panel-bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="file">{file}</span>
  </figcaption>
  <pre><code>{lines.map((l) => <span class:list={['ln', l.kind]}>{l.kind === 'add' ? '+ ' : l.kind === 'del' ? '- ' : ''}{l.text}{'\n'}</span>)}</code></pre>
</figure>

<style>
  .panel {
    margin: 0;
    background: #0b1a33;
    border-radius: var(--r-xl);
    box-shadow:
      rgba(0, 55, 112, 0.18) 0 18px 40px,
      rgba(0, 55, 112, 0.08) 0 2px 6px;
    overflow: hidden;
    color: #c9d6ea;
  }
  .panel-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: #10233f;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #2a3d5c;
  }
  .file {
    font-family: var(--mono);
    font-size: 12px;
    color: #8597b3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  pre {
    margin: 0;
    padding: 20px 22px 22px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.65;
  }
  .compact pre {
    font-size: 12px;
    padding: 16px 18px;
  }
  .comment,
  .dim {
    color: #6c7f9e;
  }
  .add {
    color: #7ee2b8;
    background: rgba(126, 226, 184, 0.08);
    display: inline-block;
    width: 100%;
  }
  .del {
    color: #ff8fa8;
    background: rgba(234, 34, 97, 0.1);
    display: inline-block;
    width: 100%;
  }
  .ok {
    color: #7ee2b8;
  }
  .warn {
    color: #ffc46b;
  }
</style>
