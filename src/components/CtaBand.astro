---
import { site } from '../site';
interface Props {
  // 'hire' speaks to recruiters and hiring managers; 'consult' to teams buying contract work.
  mode?: 'hire' | 'consult';
}
const { mode = 'hire' } = Astro.props;
const heading = mode === 'hire' ? 'Hiring a full-stack or mobile engineer?' : 'Have an app where the numbers don’t add up?';
---

<section class="section cta-wrap" id="contact">
  <div class="container">
    <div class="cta">
      <div>
        <h2 class="display-lg">{heading}</h2>
        {
          mode === 'hire' ? (
            <p class="cta-sub">
              I’m based in Seattle, working globally, and open to full-stack and mobile roles across apps, payments and the
              systems behind them. Email is the fastest way to reach me.
            </p>
          ) : (
            <p class="cta-sub">
              Tell me what’s breaking: payments, analytics, releases, or a mobile app that needs to ship. The first call
              is free, and you’ll leave with a clear next step.
            </p>
          )
        }
      </div>
      {
        mode === 'hire' ? (
          <div class="cta-actions">
            <a href={`mailto:${site.email}`} class="btn btn-on-dark">
              Email me <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a href={site.linkedin} target="_blank" rel="noopener" class="cta-mail">
              Connect on LinkedIn →
            </a>
            <a href="/consulting/" class="cta-mail">
              Contract work? See consulting →
            </a>
          </div>
        ) : (
          <div class="cta-actions">
            <a href={site.calendly} target="_blank" rel="noopener" class="btn btn-on-dark">
              Book a discovery call <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a href={`mailto:${site.email}`} class="cta-mail">
              {site.email}
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 56px;
    border-radius: var(--r-xl);
    color: var(--on-primary);
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(83, 58, 253, 0.55) 0%, rgba(83, 58, 253, 0) 55%),
      radial-gradient(90% 120% at 0% 100%, rgba(52, 140, 178, 0.45) 0%, rgba(52, 140, 178, 0) 60%),
      var(--brand-dark-900);
  }
  .cta h2 {
    color: var(--on-primary);
  }
  .cta-sub {
    margin-top: 16px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 17px;
    max-width: 520px;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    justify-self: end;
  }
  .cta-mail {
    color: rgba(255, 255, 255, 0.8);
    font-size: 15px;
  }
  .cta-mail:hover {
    color: var(--on-primary);
  }
  @media (max-width: 899px) {
    .cta {
      grid-template-columns: 1fr;
      padding: 32px 24px;
    }
    .cta-actions {
      justify-self: start;
    }
  }
</style>
